{
  "manifest_version": 3,
  "name": "REPEAT",
  "description": "Show it once. Then just press Tab. Turns one demonstration into a reusable, undoable browser automation.",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open REPEAT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://mail.google.com/*",
    "https://*.atlassian.net/*",
    "https://app.slack.com/*",
    "https://*.slack.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.atlassian.net/*",
        "https://app.slack.com/*",
        "https://*.slack.com/*"
      ],
      "js": ["content/recorder.js", "content/ghost.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Open the REPEAT side panel"
    }
  }
}
