# ─────────────────────────────────────────────────────────────────────
# REPEAT backend configuration. Copy to backend/.env and fill in.
# Nothing here is ever committed. Tokens are stored under backend/tokens/.
# ─────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────
# Port the local FastAPI service listens on. The extension is built against this port;
# if you change it, rebuild the extension with the same value: REPEAT_PORT=9000 npm run build
REPEAT_PORT=8765
# Path of the local SQLite store (demonstrations, workflows, runs).
REPEAT_DB_PATH=./repeat.db
# Log level: DEBUG | INFO | WARNING
REPEAT_LOG_LEVEL=INFO

# ── Demo mode ────────────────────────────────────────────────────────
# true  = integrations run against an in-memory sandbox (Jira/Slack/Gmail
#         fakes with realistic IDs). Safe to run on stage with no network.
# false = real Jira / Slack / Gmail APIs are used.
REPEAT_DEMO_MODE=true
# Seed the learned "Bug email to Jira and Slack" workflow on first boot.
REPEAT_SEED_DEMO=true

# ── LLM (OpenAI, structured outputs) ─────────────────────────────────
# Provider: openai | mock. "mock" returns deterministic templates
# so the demo path never depends on the network.
REPEAT_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-2024-08-06

# ── Jira Cloud (API token) ───────────────────────────────────────────
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...
# Project key used by the demo workflow.
JIRA_PROJECT_KEY=DEMO
JIRA_ISSUE_TYPE=Bug

# ── Slack (OAuth bot token) ──────────────────────────────────────────
# Scopes: chat:write, chat:write.public, channels:read
SLACK_BOT_TOKEN=xoxb-...
# Channel the demo posts to (name without #, or channel ID).
SLACK_CHANNEL=product-updates

# ── Gmail (OAuth desktop client) ─────────────────────────────────────
# Create an OAuth client (Desktop app) in Google Cloud, enable Gmail API,
# download the client JSON and point to it here. First run opens a browser.
GMAIL_CREDENTIALS_FILE=./tokens/gmail_client.json
GMAIL_TOKEN_FILE=./tokens/gmail_token.json
# Label applied to emails REPEAT has handled (created if missing).
GMAIL_HANDLED_LABEL=REPEAT/handled

# ── Speech to text (optional narration in Teach mode) ────────────────
# Uses OpenAI Whisper via the same OPENAI_API_KEY. Set false to hide it.
REPEAT_NARRATION_ENABLED=true
